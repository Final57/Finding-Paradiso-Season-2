<?xml version="1.0" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CubeBlocks>
        <Definition xsi:type="MyObjectBuilder_BeaconDefinition">
            <Id>
                <TypeId>Beacon</TypeId>
                <SubtypeId>Destroyer_Core</SubtypeId>
            </Id>
            <DisplayName>Destroyer Core</DisplayName>
            <Icon>Textures\LargeGridCore-dd.dds</Icon>
            <Description>A destroyer core for large-sized ships and vehicles.</Description>
            <CubeSize>Large</CubeSize>
            <GuiVisible>false</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Model>Models\GridCore_Center.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="50" />
                <Component Subtype="Construction" Count="75" />
                <Component Subtype="SmallTube" Count="60" />
                <Component Subtype="Computer" Count="25" />
                <Component Subtype="LargeTube" Count="10" />
                <Component Subtype="ArmoredPlate" Count="15" />
            </Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
				<MountPoint Side="Front" StartX="0.21" StartY="0.00" EndX="0.79" EndY="1.00"/>
				<MountPoint Side="Back" StartX="0.21" StartY="0.00" EndX="0.79" EndY="1.00"/>
				<MountPoint Side="Left" StartX="0.21" StartY="0.00" EndX="0.79" EndY="1.00"/>
				<MountPoint Side="Right" StartX="0.21" StartY="0.00" EndX="0.79" EndY="1.00"/>
				<MountPoint Side="Top" StartX="0.20" StartY="0.00" EndX="0.80" EndY="1.00"/>
				<MountPoint Side="Top" StartX="0.00" StartY="0.20" EndX="1.00" EndY="0.80"/>
				<MountPoint Side="Top" StartX="0.10" StartY="0.10" EndX="0.90" EndY="0.90"/>
				<MountPoint Side="Bottom" StartX="0.20" StartY="0.00" EndX="0.80" EndY="1.00"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.20" EndX="1.00" EndY="0.80"/>
				<MountPoint Side="Bottom" StartX="0.10" StartY="0.10" EndX="0.90" EndY="0.90"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\GridCore_Center_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\GridCore_Center_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\GridCore_Center_BS3.mwm"/>
			</BuildProgressModels>
            <ScreenAreas>
                <ScreenArea Name="CockpitScreen_02" DisplayName="Screen 1" TextureResolution="512" ScreenWidth="5" ScreenHeight="3" />
				<ScreenArea Name="CockpitScreen_01" DisplayName="Screen 2" TextureResolution="512" ScreenWidth="5" ScreenHeight="3" />
            </ScreenAreas>
			<MirroringY>Z</MirroringY>
			<MirroringZ>Y</MirroringZ>
            <BlockPairName>Destroyer_Core</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>15</BuildTimeSeconds>
            <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
            <DamagedSound>ParticleElectrical</DamagedSound>

            <!-- Beacon properties -->
            <ResourceSinkGroup>Utility</ResourceSinkGroup>
            <MaxBroadcastRadius>200000</MaxBroadcastRadius>
            <Flare>BeaconSmall</Flare>
            <MaxBroadcastPowerDrainkW>20</MaxBroadcastPowerDrainkW>
            <!-- End Beacon Props-->

            <EmissiveColorPreset>Beacon</EmissiveColorPreset>
            <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>50</PCU>
            <IsAirTight>false</IsAirTight>
        </Definition>
	</CubeBlocks>
</Definitions>