<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <BlockVariantGroups>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="General_Cores" />
            <Icon>Textures\LargeGridCore.png</Icon>
            <DisplayName>General Cores</DisplayName>
            <Description>Basic Starting cores for ships and bases.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_Beacon" Subtype="LG_General_Core" />
                <Block Type="MyObjectBuilder_Beacon" Subtype="SG_General_Core" />
            </Blocks>
        </BlockVariantGroup>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="Scrap_Cores" />
            <Icon>Textures\LargeGridCore.png</Icon>
            <DisplayName>Scrap Cores</DisplayName>
            <Description>Salvage claim cores for derelict ships and stations.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_Beacon" Subtype="LG_Scrap_Core" />
                <Block Type="MyObjectBuilder_Beacon" Subtype="SG_Scrap_Core" />
            </Blocks>
        </BlockVariantGroup>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="Core_Modules" />
            <Icon>Textures\LargeGridCore.png</Icon>
            <DisplayName>Core Upgrade Modules</DisplayName>
            <Description>Support Modules to increase specific aspects of a Core's particular boosts.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_Beacon" Subtype="LG_Ship_Core_Module_Bastion" />
                <Block Type="MyObjectBuilder_Beacon" Subtype="SG_Ship_Core_Module_Bastion" />
                <Block Type="MyObjectBuilder_Beacon" Subtype="LG_Ship_Core_Module_Mobility" />
                <Block Type="MyObjectBuilder_Beacon" Subtype="SG_Ship_Core_Module_Mobility" />               
            </Blocks>
        </BlockVariantGroup>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="Utility_Cores" />
            <Icon>Textures\LargeGridCore.png</Icon>
            <DisplayName>Utility Cores</DisplayName>
            <Description>Cores focused on utility functions for ships.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_Beacon" Subtype="Light_Utility_Core" />
                <Block Type="MyObjectBuilder_Beacon" Subtype="Heavy_Utility_Core" />
            </Blocks>
        </BlockVariantGroup>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="Transport_Cores" />
            <Icon>Textures\LargeGridCore.png</Icon>
            <DisplayName>Transport Cores</DisplayName>
            <Description>Cores designed for hauling cargo or personnel.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_Beacon" Subtype="Heavy_Transport_Core" />
                <Block Type="MyObjectBuilder_Beacon" Subtype="Light_Transport_Core" />
            </Blocks>
        </BlockVariantGroup>
    </BlockVariantGroups>
</Definitions>
