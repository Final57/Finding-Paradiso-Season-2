<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <!-- New spotlights-->
    <!-- Large Block -->
    <Definition xsi:type="MyObjectBuilder_ReflectorBlockDefinition">
      <Id>
        <TypeId>ReflectorLight</TypeId>
        <SubtypeId>LargeBlockFrontHighPowerLight</SubtypeId>
      </Id>
      <Components>
        <Component Subtype="SteelPlate" Count="8" />
        <Component Subtype="CopperWire" Count="15" />
        <Component Subtype="Lightbulb" Count="2" />
        <Component Subtype="LargeTube" Count="2" />
        <Component Subtype="InteriorPlate" Count="20" />
        <Component Subtype="Construction" Count="15" />
        <Component Subtype="BulletproofGlass" Count="4" />
      </Components>
      <CriticalComponent Subtype="Construction" Index="0" />
    </Definition>

    <!-- Small Block -->
    <Definition xsi:type="MyObjectBuilder_ReflectorBlockDefinition">
      <Id>
        <TypeId>ReflectorLight</TypeId>
        <SubtypeId>SmallBlockFrontHighPowerLight</SubtypeId>
      </Id>
      <Components>
        <Component Subtype="SteelPlate" Count="1" />
        <Component Subtype="CopperWire" Count="8" />
        <Component Subtype="Lightbulb" Count="1" />
        <Component Subtype="LargeTube" Count="1" />
        <Component Subtype="InteriorPlate" Count="1" />
        <Component Subtype="Construction" Count="1" />
        <Component Subtype="BulletproofGlass" Count="2" />
      </Components>
      <CriticalComponent Subtype="Construction" Index="0" />
    </Definition>

    <!-- Offset Small Block -->
    <Definition xsi:type="MyObjectBuilder_ReflectorBlockDefinition">
      <Id>
        <TypeId>ReflectorLight</TypeId>
        <SubtypeId>HighPowerOffsetSpotlight</SubtypeId>
      </Id>
      <Components>
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="Lightbulb" Count="2" />
        <Component Subtype="BulletproofGlass" Count="1" />
      </Components>
      <CriticalComponent Subtype="BulletproofGlass" Index="0" />
    </Definition>
  </CubeBlocks>
</Definitions>
